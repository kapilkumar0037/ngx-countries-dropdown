/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2024",
    "module": "preserve",
    "useDefineForClassFields": false,
    "paths": {
      "@ngx-countries-dropdown": [
        "./projects/ngx-countries-dropdown/src/public_api"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ngx-countries-dropdown/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx-countries-dropdown/tsconfig.spec.json"
    },
    {
      "path": "./projects/sandbox/tsconfig.app.json"
    },
    {
      "path": "./projects/sandbox/tsconfig.spec.json"
    }
  ]
}
